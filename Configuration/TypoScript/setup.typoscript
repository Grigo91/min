plugin {
    tx_min {
        tinysource {
            enable = 1
            body {
                stripComments = 1
                preventStripOfSearchComment = 1
                removeTypeInScriptTags = 1
            }

            protectCode {
                10 = /(<textarea.*?>.*?<\/textarea>)/is
                20 = /(<pre.*?>.*?<\/pre>)/is
            }
        }
    }
}

# This disables the tinysource feature of EXT:min
[backend.user.isLoggedIn && request && traverse(request.getQueryParams(), 'debug') > 0]
    plugin.tx_min {
        tinysource.enable = 0
    }

    config {
        linkVars := addToList(debug(1))
        no_cache = 1
    }
[global]
